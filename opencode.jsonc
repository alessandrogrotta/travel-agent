{
  "$schema": "https://opencode.ai/config.json",
  // Phase 2/6 - MCP Blitz: at least 2 out of 3 must be active (check with: opencode mcp list)
  // MCP is an optimization, not a requirement: if it fails, the skills fall back to LLM knowledge.
  "mcp": {
    "parallel-search": {
      "type": "remote",
      "url": "https://search.parallel.ai/mcp",
      "enabled": true
    },
    "viator": {
      "type": "remote",
      "url": "https://exp-app-mcp.prod.ep.viator.com/mcp",
      "enabled": true
    },
    "gondola": {
      "type": "remote",
      "url": "https://mcp.gondola.ai/mcp",
      "enabled": true
    }
  }
}
